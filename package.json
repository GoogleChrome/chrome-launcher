{
  "name": "chrome-launcher",
  "main": "./dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "test/run-tests.sh",
    "test-formatting": "test/check-formatting.sh",
    "format": "scripts/format.sh",
    "reset-link": "(yarn unlink || true) && yarn link && yarn --cwd node_modules/lighthouse/ link chrome-launcher"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "print-chrome-path": "bin/print-chrome-path.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sinon": "^22.0.2",
    "clang-format": "^1.8.0",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "escape-string-regexp": "^5.0.0",
    "is-wsl": "^3.1.1",
    "lighthouse-logger": "^2.0.2"
  },
  "peerDependencies": {
    "@types/node": "*"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "version": "1.2.3",
  "types": "./dist/index.d.ts",
  "description": "Launch latest Chrome with the Devtools Protocol port open",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoogleChrome/chrome-launcher.git"
  },
  "author": "The Chromium Authors",
  "license": "Apache-2.0"
}
