{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "src",
        "types": ["node"],
        "skipLibCheck": true,
        "outDir": "dist",
        "target": "es2021",
        "declaration": true,
        "strict": false,
        "noImplicitAny": true,
        "inlineSourceMap": true,
        "noEmitOnError": false,
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "allowSyntheticDefaultImports": true,
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src",
    ]
}
